# Mitlesen der Netzwerkpakete braucht CAP_NET_RAW. Jede neue Binary braucht das erneut.
_grant_capture() {
  if setcap cap_net_raw,cap_net_admin=eip /usr/bin/fateweaver; then
    echo "==> Fateweaver darf jetzt Pakete mitlesen."
  else
    echo "==> Konnte Berechtigung nicht setzen. Bitte ausfuehren:"
    echo "    sudo setcap cap_net_raw,cap_net_admin=eip /usr/bin/fateweaver"
  fi
}
post_install() { _grant_capture; }
post_upgrade() { _grant_capture; }

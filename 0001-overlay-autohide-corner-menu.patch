diff --git a/public/fw/autohide.js b/public/fw/autohide.js
new file mode 100644
index 0000000..de838e1
--- /dev/null
+++ b/public/fw/autohide.js
@@ -0,0 +1,64 @@
+/* Fateweaver (Linux build): the meter shows only while you fight, for a while after the fight,
+   and while an alert is up. Otherwise it fades out and lets clicks through to the game. The corner
+   menu (corner.html) can pin it shown; Settings > Overlay turns all of this on or off. The page
+   keeps running while hidden, so timers and alerts still fire. */
+(() => {
+  if (window.A2_VIEW !== "main") return; // settings/details/history share this bundle
+
+  const ALERT_MS = 20e3; // as long as a toast stays up (toast.js)
+  const PIN_KEY = "fw.autohidePinned";
+  const invoke = (cmd, args) => window.__TAURI__?.core?.invoke(cmd, args).catch(() => {});
+
+  const style = document.createElement("style");
+  style.textContent = `
+    body { transition: opacity .35s ease; }
+    html.fwAutoHidden body { opacity: 0; pointer-events: none; }
+  `;
+  document.head.appendChild(style);
+
+  const cfg = window.FW_OVERLAY_CFG.read();
+  let pinned = localStorage.getItem(PIN_KEY) === "1";
+  let showUntil = 0;
+  let wasFighting = false;
+  let hidden = null;
+
+  const fighting = () => document.querySelector(".battleTime")?.classList.contains("state-fighting") ?? false;
+
+  const apply = () => {
+    const now = Date.now();
+    const f = fighting();
+    if (f || wasFighting) showUntil = Math.max(showUntil, now + cfg.lingerSec * 1e3);
+    wasFighting = f;
+    const next = cfg.autohide && !(pinned || f || now < showUntil);
+    if (next === hidden) return;
+    hidden = next;
+    document.documentElement.classList.toggle("fwAutoHidden", hidden);
+    invoke("fw_set_autohidden", { hidden });
+  };
+
+  const corner = () => invoke(cfg.corner ? "fw_open_corner" : "fw_close_corner");
+
+  // Every alert goes through the notification bucket (alerts.js calls FW.notifs.push).
+  const N = window.FW?.notifs;
+  if (N?.push) {
+    const push = N.push;
+    N.push = (...a) => { showUntil = Math.max(showUntil, Date.now() + ALERT_MS); apply(); return push(...a); };
+  }
+
+  window.__fwSetPinned = (p) => {
+    pinned = !!p;
+    localStorage.setItem(PIN_KEY, pinned ? "1" : "0");
+    apply();
+  };
+  window.__fwOverlaySettings = (next) => {
+    Object.assign(cfg, window.FW_OVERLAY_CFG.write(next));
+    apply();
+    corner();
+  };
+
+  document.addEventListener("DOMContentLoaded", () => {
+    apply();
+    setInterval(apply, 500);
+    setTimeout(corner, 1500); // the corner window is placed on the meter's monitor
+  });
+})();

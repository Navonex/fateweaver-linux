diff --git a/src-tauri/src/fateweaver.rs b/src-tauri/src/fateweaver.rs
index 4da777d..8906077 100644
--- a/src-tauri/src/fateweaver.rs
+++ b/src-tauri/src/fateweaver.rs
@@ -205,6 +205,72 @@ pub fn close_toasts(app: tauri::AppHandle) {
     }
 }
 
+// ===== Corner button (Linux build) =====
+// A small always-on-top button in the top-left corner of the meter's monitor. It opens a tiny
+// menu: keep the meter shown or let it auto-hide, open the hub, open the meter settings.
+
+const CORNER_BTN: f64 = 34.0; // logical px, collapsed size
+
+#[tauri::command]
+pub async fn fw_open_corner(app: tauri::AppHandle) -> Result<(), String> {
+    if app.get_webview_window("fwcorner").is_some() {
+        return Ok(());
+    }
+    let main = app.get_webview_window("main").ok_or("meter window not found")?;
+    let mon = main.current_monitor().ok().flatten().or_else(|| main.primary_monitor().ok().flatten());
+    let (x, y, scale) = match &mon {
+        Some(m) => (m.position().x as f64, m.position().y as f64, m.scale_factor()),
+        None => (0.0, 0.0, 1.0),
+    };
+    let win = tauri::WebviewWindowBuilder::new(&app, "fwcorner", tauri::WebviewUrl::App("corner.html".into()))
+        .title("Fateweaver menu")
+        .inner_size(CORNER_BTN, CORNER_BTN)
+        .position(x / scale, y / scale)
+        .decorations(false)
+        .transparent(true)
+        .shadow(false)
+        .always_on_top(true)
+        .skip_taskbar(true)
+        .resizable(false)
+        .focused(false)
+        .build()
+        .map_err(|e| e.to_string())?;
+    let _ = win.set_position(tauri::PhysicalPosition::new(x as i32, y as i32));
+    tracing::info!("fw corner button at {x},{y} (scale {scale})");
+    Ok(())
+}
+
+/// The corner page grows into its menu and shrinks back to the button.
+#[tauri::command]
+pub fn fw_corner_size(window: tauri::WebviewWindow, width: f64, height: f64) {
+    let _ = window.set_size(tauri::LogicalSize::new(width, height));
+}
+
+#[tauri::command]
+pub fn fw_close_corner(app: tauri::AppHandle) {
+    if let Some(w) = app.get_webview_window("fwcorner") {
+        let _ = w.close();
+    }
+}
+
+/// The settings window changed the overlay options; hand them to the meter page.
+#[tauri::command]
+pub fn fw_overlay_settings(app: tauri::AppHandle, autohide: bool, linger_sec: u32, corner: bool) {
+    if let Some(main) = app.get_webview_window("main") {
+        let _ = main.eval(&format!(
+            "window.__fwOverlaySettings && window.__fwOverlaySettings({{autohide: {autohide}, lingerSec: {linger_sec}, corner: {corner}}})"
+        ));
+    }
+}
+
+/// Keep the meter shown (true) or let it auto-hide (false).
+#[tauri::command]
+pub fn fw_set_pinned(app: tauri::AppHandle, pinned: bool) {
+    if let Some(main) = app.get_webview_window("main") {
+        let _ = main.eval(&format!("window.__fwSetPinned && window.__fwSetPinned({pinned})"));
+    }
+}
+
 // ===== Field boss deaths (OI-006) =====
 // The parser's `42 36 <entity> 0 3` record is a combat death. When the entity is a flagged boss,
 // data_storage hands its NPC code here; the meter drains the queue and keeps the kill log.

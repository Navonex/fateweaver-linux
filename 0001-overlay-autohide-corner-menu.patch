diff --git a/public/fw/corner.js b/public/fw/corner.js
new file mode 100644
index 0000000..2b4565d
--- /dev/null
+++ b/public/fw/corner.js
@@ -0,0 +1,29 @@
+/* Fateweaver (Linux build): corner button and its menu. The window is only as big as what is
+   shown, so the rest of the screen corner stays clickable for the game. */
+(() => {
+  const PIN_KEY = "fw.autohidePinned";
+  const invoke = (cmd, args) => window.__TAURI__?.core?.invoke(cmd, args).catch(() => {});
+  const btn = document.getElementById("btn"), menu = document.getElementById("menu"), pin = document.getElementById("pin");
+  const pinned = () => localStorage.getItem(PIN_KEY) === "1";
+
+  const label = () => { pin.textContent = pinned() ? "Meter: automatisch ein-/ausblenden" : "Meter: immer anzeigen"; };
+  const open = (on) => {
+    menu.hidden = !on;
+    document.body.classList.toggle("open", on);
+    if (on) label();
+    invoke("fw_corner_size", on ? { width: 200, height: 36 + menu.offsetHeight + 4 } : { width: 34, height: 34 });
+  };
+  const close = () => open(false);
+
+  btn.addEventListener("click", () => open(menu.hidden));
+  pin.addEventListener("click", () => {
+    const next = !pinned();
+    localStorage.setItem(PIN_KEY, next ? "1" : "0");
+    invoke("fw_set_pinned", { pinned: next });
+    close();
+  });
+  document.getElementById("hub").addEventListener("click", () => { invoke("open_hub_window"); close(); });
+  document.getElementById("settings").addEventListener("click", () => { invoke("open_settings_window"); close(); });
+  window.addEventListener("blur", close);
+  document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
+})();
diff --git a/public/fw/overlay-settings.js b/public/fw/overlay-settings.js
new file mode 100644
index 0000000..9decebf
--- /dev/null
+++ b/public/fw/overlay-settings.js
@@ -0,0 +1,37 @@
+/* Fateweaver (Linux build): Settings > Overlay. Stores the options and hands them to the meter
+   window, which applies them right away (autohide.js). */
+(() => {
+  const KEY = "fw.overlay";
+  const DEF = { autohide: true, lingerSec: 15, corner: true };
+  const clamp = (v) => Math.min(120, Math.max(5, Math.round(Number(v) / 5) * 5 || DEF.lingerSec));
+  const read = () => {
+    try { const c = { ...DEF, ...JSON.parse(localStorage.getItem(KEY) || "{}") }; c.lingerSec = clamp(c.lingerSec); return c; }
+    catch { return { ...DEF }; }
+  };
+  const write = (c) => { const v = { ...read(), ...c }; v.lingerSec = clamp(v.lingerSec); localStorage.setItem(KEY, JSON.stringify(v)); return v; };
+  window.FW_OVERLAY_CFG = { read, write };
+})();
+
+document.addEventListener("DOMContentLoaded", () => {
+  const auto = document.querySelector(".fwAutohideCheckbox");
+  const linger = document.querySelector(".fwLingerInput");
+  const lingerVal = document.querySelector(".fwLingerValue");
+  const corner = document.querySelector(".fwCornerCheckbox");
+  if (!auto || !linger || !corner) return;
+
+  const c = window.FW_OVERLAY_CFG.read();
+  auto.checked = c.autohide;
+  linger.value = c.lingerSec;
+  lingerVal.textContent = `${c.lingerSec} s`;
+  corner.checked = c.corner;
+
+  const send = () => {
+    const v = window.FW_OVERLAY_CFG.write({ autohide: auto.checked, lingerSec: linger.value, corner: corner.checked });
+    lingerVal.textContent = `${v.lingerSec} s`;
+    window.__TAURI__?.core?.invoke("fw_overlay_settings", { autohide: v.autohide, lingerSec: v.lingerSec, corner: v.corner }).catch(() => {});
+  };
+  auto.addEventListener("change", send);
+  corner.addEventListener("change", send);
+  linger.addEventListener("input", () => { lingerVal.textContent = `${linger.value} s`; });
+  linger.addEventListener("change", send);
+});
